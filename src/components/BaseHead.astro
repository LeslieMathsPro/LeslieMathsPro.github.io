---
import { SITE_DESCRIPTION, SITE_TITLE, HERO, SOCIALS } from '@/consts';
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** OG 图片路径，站内绝对路径即可，如 '/og-default.png' */
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = '/og-default.png',
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
	'@type': 'Person',
	name: HERO.name,
	url: Astro.site?.href,
	...(SOCIALS.github ? { sameAs: [SOCIALS.github] } : {}),
};

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: ogImageURL.href,
				url: canonicalURL.href,
				datePublished: publishedTime?.toISOString(),
				dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
				keywords: tags.join(', '),
				author: personSchema,
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				description,
				url: Astro.site?.href,
				author: personSchema,
			};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<link rel="canonical" href={canonicalURL} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={HERO.name} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}

<meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

{/* 在样式生效前同步决定主题，避免刷新时的白屏闪烁 */}
<script is:inline>
	(function () {
		const stored = localStorage.getItem('theme');
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		if (stored === 'dark' || (!stored && prefersDark)) {
			document.documentElement.classList.add('dark');
		}
	})();
</script>
