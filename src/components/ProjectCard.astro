---
import type { Project } from '@/data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article
	class="rounded-xl border border-zinc-200 p-5 transition-colors hover:border-accent-300 dark:border-zinc-800 dark:hover:border-accent-400/50"
>
	<div class="flex items-start justify-between gap-3">
		<h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
			{project.name}
		</h3>
		{
			project.status && (
				<span class="shrink-0 rounded-full border border-zinc-200 px-2 py-0.5 text-[11px] text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
					{project.status}
				</span>
			)
		}
	</div>

	<p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
		{project.summary}
	</p>

	{
		project.highlights.length > 0 && (
			<ul class="mt-4 space-y-1.5">
				{project.highlights.map((item) => (
					<li class="flex gap-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
						<span class="mt-2 size-1 shrink-0 rounded-full bg-accent-500" aria-hidden="true"></span>
						<span>{item}</span>
					</li>
				))}
			</ul>
		)
	}

	<div class="mt-4 flex flex-wrap gap-1.5">
		{
			project.stack.map((tech) => (
				<span class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-[11px] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
					{tech}
				</span>
			))
		}
	</div>

	{
		(project.repo || project.demo) && (
			<div class="mt-4 flex gap-4 text-sm">
				{project.repo && (
					<a
						href={project.repo}
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent-600 hover:underline dark:text-accent-400"
					>
						源码 →
					</a>
				)}
				{project.demo && (
					<a
						href={project.demo}
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent-600 hover:underline dark:text-accent-400"
					>
						在线演示 →
					</a>
				)}
			</div>
		)
	}
</article>
