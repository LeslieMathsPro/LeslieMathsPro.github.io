---
import type { Post } from '@/lib/posts';
import { getReadingTime } from '@/lib/posts';
import FormattedDate from './FormattedDate.astro';
import TagPill from './TagPill.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<article
	class="group border-b border-zinc-200 py-7 last:border-0 dark:border-zinc-800"
>
	<div class="flex items-center gap-3 text-xs text-zinc-500">
		<FormattedDate date={post.data.pubDate} />
		<span aria-hidden="true">·</span>
		<span>{readingTime} 分钟</span>
		{
			post.data.draft && (
				<span class="rounded bg-amber-100 px-1.5 py-0.5 font-medium text-amber-700 dark:bg-amber-500/15 dark:text-amber-400">
					草稿
				</span>
			)
		}
	</div>

	<h2 class="mt-2 text-lg font-semibold tracking-tight">
		<a
			href={`/posts/${post.id}/`}
			class="text-zinc-900 transition-colors group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400"
		>
			{post.data.title}
		</a>
	</h2>

	<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
		{post.data.description}
	</p>

	{
		post.data.tags.length > 0 && (
			<div class="mt-3 flex flex-wrap gap-1.5">
				{post.data.tags.map((tag) => (
					<TagPill tag={tag} />
				))}
			</div>
		)
	}
</article>
