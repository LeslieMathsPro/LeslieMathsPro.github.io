---
import PostCard from '@/components/PostCard.astro';
import TagPill from '@/components/TagPill.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '@/lib/posts';

const posts = await getPublishedPosts();
const tags = await getTagCounts();
---

<BaseLayout title="文章" description="全部技术文章归档">
	<h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">文章</h1>
	<p class="mt-2 text-sm text-zinc-500">共 {posts.length} 篇</p>

	{
		tags.length > 0 && (
			<div class="mt-6 flex flex-wrap gap-1.5">
				{tags.map(({ tag, count }) => (
					<TagPill tag={tag} count={count} />
				))}
			</div>
		)
	}

	<div class="mt-8 border-t border-zinc-200 dark:border-zinc-800">
		{
			posts.length > 0 ? (
				posts.map((post) => <PostCard post={post} />)
			) : (
				<p class="py-10 text-sm text-zinc-500">
					还没有文章。在 <code>src/content/posts/</code> 下新建 .md 或 .mdx 即可。
				</p>
			)
		}
	</div>
</BaseLayout>
