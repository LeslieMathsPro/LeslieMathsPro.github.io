---
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FEATURED_POST_COUNT, FEATURED_PROJECT_COUNT, HERO, SOCIALS } from '@/consts';
import { PROJECTS } from '@/data/projects';
import { getFeaturedPosts } from '@/lib/posts';

const posts = await getFeaturedPosts(FEATURED_POST_COUNT);

const featuredProjects = PROJECTS.filter((project) => project.featured).slice(
	0,
	FEATURED_PROJECT_COUNT,
);
---

<BaseLayout>
	{/* 强定位区：面试官通常只看这一屏，信息必须密度高且可验证 */}
	<section class="pb-4">
		<h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
			{HERO.name}
		</h1>
		<p class="mt-3 text-lg text-accent-600 dark:text-accent-400">{HERO.tagline}</p>
		<p class="mt-5 max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
			{HERO.intro}
		</p>

		<div class="mt-6 flex flex-wrap gap-1.5">
			{
				HERO.keywords.map((keyword) => (
					<span class="rounded-md bg-zinc-100 px-2 py-1 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
						{keyword}
					</span>
				))
			}
		</div>

		<div class="mt-8 flex flex-wrap items-center gap-3">
			{
				SOCIALS.email && (
					<a
						href={`mailto:${SOCIALS.email}`}
						class="rounded-lg bg-accent-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-700"
					>
						联系我
					</a>
				)
			}
			{
				SOCIALS.github && (
					<a
						href={SOCIALS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-600"
					>
						GitHub
					</a>
				)
			}
			{
				SOCIALS.resume && (
					<a
						href={SOCIALS.resume}
						class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-600"
					>
						下载简历
					</a>
				)
			}
		</div>
	</section>

	<section class="mt-16">
		<div class="flex items-baseline justify-between">
			<h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">精选文章</h2>
			<a
				href="/posts"
				class="text-sm text-accent-600 hover:underline dark:text-accent-400">全部文章 →</a
			>
		</div>
		<div class="mt-2">
			{
				posts.length > 0 ? (
					posts.map((post) => <PostCard post={post} />)
				) : (
					<p class="py-8 text-sm text-zinc-500">
						还没有文章。在 <code>src/content/posts/</code> 下新建 .md 或 .mdx 即可。
					</p>
				)
			}
		</div>
	</section>

	{
		featuredProjects.length > 0 && (
			<section class="mt-16">
				<div class="flex items-baseline justify-between">
					<h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">代表项目</h2>
					<a
						href="/projects"
						class="text-sm text-accent-600 hover:underline dark:text-accent-400"
					>
						全部项目 →
					</a>
				</div>
				<div class="mt-5 grid gap-4">
					{featuredProjects.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>
