---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404 - 你访问的页面不存在">
	<div class="py-16 text-center">
		<p class="font-mono text-5xl font-bold text-accent-500">404</p>
		<h1 class="mt-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">
			这个页面不存在
		</h1>
		<p class="mt-2 text-sm text-zinc-500">链接可能已经失效，或者地址输错了。</p>
		<div class="mt-8 flex justify-center gap-3">
			<a
				href="/"
				class="rounded-lg bg-accent-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-700"
			>
				回到首页
			</a>
			<a
				href="/posts"
				class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-600"
			>
				浏览文章
			</a>
		</div>
	</div>
</BaseLayout>
